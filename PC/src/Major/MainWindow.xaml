<Window Icon="/Major;component/Assets/Major.ico" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" x:Class="Major.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Major" Width="1440" Height="820" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
  <Grid x:Name="ShellGrid" Background="{DynamicResource AppBackground}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
      <Image Source="/Major;component/Assets/Major.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo Major"/>
      <TextBlock x:Name="BrandName" Text="Major" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid Grid.Column="1" Margin="12,0,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="SidebarToggle" Content="‹" Click="SidebarToggleClick" Width="36" Height="36" Padding="0" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Riduci barra laterale" AutomationProperties.Name="Riduci barra laterale"/><TextBlock Grid.Column="1" Text="Il tuo schermo sul desktop" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Gratuito · Locale · Open source" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"/></Grid>
    <Grid x:Name="NavigationPanel" Grid.Row="1" Margin="16,8,16,24" ClipToBounds="True">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Width="196" HorizontalAlignment="Left"><TextBlock x:Name="DevicesHeading" Text="Dispositivi" Style="{StaticResource Section}" Margin="8,4,0,12"/><Button x:Name="RefreshButton" Content="_Aggiorna dispositivi" Click="RefreshClick" Margin="0,0,0,16"/></StackPanel>
      <Grid Grid.Row="1">
        <ListBox x:Name="DevicesList" Background="Transparent" BorderThickness="0" SelectionChanged="SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Dispositivi Android">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlSurface}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Model}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusLabel}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Serial}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyDevices" Text="Nessun dispositivo rilevato.&#10;Collega il telefono via USB.&#10;Per il Wi-Fi usa il pulsante in basso." Margin="8,12,8,0" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Row="2"><Button x:Name="AdbNavigationButton" Content="Android USB / ADB" Tag="USB" ToolTip="Android USB / ADB" Height="36" Click="AdbClick" Margin="0,0,0,8"/><Button x:Name="AppleNavigationButton" Content="Ricevi da iPhone/iPad" Tag="iOS" ToolTip="Ricevi da iPhone/iPad" Height="36" Click="AirPlayClick" Margin="0,16,0,8"/><Button x:Name="AndroidNavigationButton" Content="Ricevi da Android" Tag="Android" ToolTip="Ricevi da Android" Height="36" Click="ReceiveClick" Margin="0,0,0,8"/><Button x:Name="WifiNavigationButton" Content="Collega via _Wi-Fi (ADB)" Tag="ADB Wi-Fi" ToolTip="Collega via Wi-Fi (ADB)" Height="36" Click="WifiClick" Margin="0,0,0,8"/><Button x:Name="FolderNavigationButton" Content="Apri cartella acquisizioni" Tag="Cartella" ToolTip="Apri cartella acquisizioni" Height="36" Click="OpenFolderClick"/><Button x:Name="SettingsNavigationButton" Content="Impostazioni" Tag="Imp." ToolTip="Impostazioni" Height="36" Click="SettingsClick" Margin="0,16,0,0"/><TextBlock x:Name="DeviceCount" Width="196" HorizontalAlignment="Left" TextWrapping="NoWrap" Text="Ricerca dispositivi…" FontSize="12" Margin="8,16,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
    </Grid>
    <Border x:Name="AdbPanel" Grid.Row="1" Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SheetBorder}" BorderThickness="1" CornerRadius="16" Margin="0,0,8,8">
      <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,24"><StackPanel Margin="0,0,160,0"><TextBlock x:Name="DeviceTitle" Text="Connessione Android" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DeviceSubtitle" Text="Collega un telefono per iniziare." Margin="0,6,0,0" Foreground="{DynamicResource Muted}"/></StackPanel><Button Content="Guida e comandi" HorizontalAlignment="Right" VerticalAlignment="Top" Click="HelpClick"/></Grid>
        <!-- 2 columns: remaining space + 24px gutter + 252px settings; equal 24px outer padding. -->
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="252"/></Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
              <Border Background="{DynamicResource SubtleSurface}" CornerRadius="8" Padding="20" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="StateTitle" Text="Pronto quando lo sei tu" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StateDescription" Text="Abilita Debug USB nelle opzioni sviluppatore di Android, collega un cavo dati e autorizza questo computer sul telefono." Margin="0,10,0,16" Style="{StaticResource MutedText}"/><Button x:Name="StartButton" Content="_Avvia mirroring" Style="{StaticResource Primary}" Click="StartClick" HorizontalAlignment="Left" IsEnabled="False" MinWidth="166"/><WrapPanel Margin="0,12,0,0"><Button x:Name="StopButton" Content="_Termina sessione" Click="StopClick" Margin="0,0,8,8" IsEnabled="False"/><Button x:Name="ScreenshotButton" Content="_Screenshot" Click="ScreenshotClick" Margin="0,0,0,8" IsEnabled="False"/></WrapPanel><TextBlock Text="Lo schermo si apre in una finestra dedicata, ridimensionabile e a schermo intero." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
              <TextBlock Text="Acquisizioni" Style="{StaticResource Section}"/>
              <CheckBox x:Name="RecordCheck" Content="Registra il video dall'avvio" ToolTip="Avvia una nuova sessione per registrare; Termina sessione finalizza il file MP4."/>
              <TextBlock Text="Video MP4 e screenshot PNG vengono salvati nella cartella scelta. Le impostazioni si applicano alla prossima sessione." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
              <TextBlock x:Name="OutputPath" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
              <Button Content="Cambia cartella…" Click="ChooseFolderClick" HorizontalAlignment="Left" Margin="0,0,0,24"/>
              <TextBlock Text="Controllo e appunti" Style="{StaticResource Section}"/>
              <TextBlock Text="Clic e trascinamento per il touch, rotella per scorrere. Scrivi direttamente nella finestra del telefono. Ctrl+V incolla gli appunti; Alt+F attiva lo schermo intero." Style="{StaticResource MutedText}"/>
              <TextBlock Text="Gli appunti dipendono dalla versione Android e dai permessi del dispositivo. Le schermate protette possono apparire nere." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
            <TextBlock Text="Qualità e comportamento" Style="{StaticResource Section}"/>
            <TextBlock Text="Lato massimo" Margin="0,0,0,6"/><ComboBox x:Name="SizeCombo" SelectedIndex="3" AutomationProperties.Name="Lato massimo video"><ComboBoxItem Content="Originale" Tag="0"/><ComboBoxItem Content="960 px" Tag="960"/><ComboBoxItem Content="1280 px" Tag="1280"/><ComboBoxItem Content="1920 px" Tag="1920"/><ComboBoxItem Content="2560 px" Tag="2560"/></ComboBox>
            <TextBlock Text="Bitrate video" Margin="0,16,0,6"/><ComboBox x:Name="BitrateCombo" SelectedIndex="2" AutomationProperties.Name="Bitrate video"><ComboBoxItem Content="2 Mbps" Tag="2"/><ComboBoxItem Content="4 Mbps" Tag="4"/><ComboBoxItem Content="8 Mbps" Tag="8"/><ComboBoxItem Content="16 Mbps" Tag="16"/><ComboBoxItem Content="32 Mbps" Tag="32"/></ComboBox>
            <TextBlock Text="Limite frame rate" Margin="0,16,0,6"/><ComboBox x:Name="FpsCombo" SelectedIndex="1" AutomationProperties.Name="Frame rate"><ComboBoxItem Content="30 fps" Tag="30"/><ComboBoxItem Content="60 fps" Tag="60"/><ComboBoxItem Content="90 fps" Tag="90"/><ComboBoxItem Content="120 fps" Tag="120"/></ComboBox>
            <StackPanel Margin="0,24,0,0"><CheckBox x:Name="AwakeCheck" Content="Mantieni telefono attivo" IsChecked="True"/><CheckBox x:Name="ScreenOffCheck" Content="Spegni schermo del telefono"/><CheckBox x:Name="FullscreenCheck" Content="Avvia a schermo intero"/><CheckBox x:Name="ReconnectCheck" Content="Riconnetti se si scollega" IsChecked="True"/><CheckBox x:Name="UhidCheck" Content="Tastiera fisica (UHID)" ToolTip="Richiede Android 9+ e supporto UHID. Imposta il layout tastiera nelle impostazioni Android."/></StackPanel>
            <TextBlock Text="Per una connessione più fluida, prova 1280 px e 4 Mbps. Il frame rate effettivo dipende dal telefono e dai cambiamenti sullo schermo." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,16"/>
            <Button Content="Salva impostazioni" Click="SaveClick"/>
          </StackPanel></ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,20,0,0"><Border Background="{DynamicResource SubtleSurface}" CornerRadius="6" Padding="12,10"><TextBlock x:Name="StatusText" Text="Inizializzazione…" AutomationProperties.LiveSetting="Polite"/></Border><Expander Header="Registro sessioni" Margin="0,12,0,0"><TextBox x:Name="LogBox" IsReadOnly="True" Height="120" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SubtleSurface}"/></Expander></StackPanel>
      </Grid>
    </Border>
    <Border x:Name="SettingsPanel" Visibility="Collapsed" Grid.Row="1" Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource SheetBorder}" BorderThickness="1" CornerRadius="16" Margin="0,0,8,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="Impostazioni" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Major, come preferisci tu." Foreground="{DynamicResource Muted}" Margin="0,6,0,28"/>
        <TextBlock Text="Aspetto" Style="{StaticResource Section}"/>
        <TextBlock Text="Tema dell’app" Margin="0,0,0,8"/><ComboBox x:Name="ThemeCombo" Width="300" HorizontalAlignment="Left" SelectionChanged="PreferencesChanged" AutomationProperties.Name="Tema dell’app"><ComboBoxItem Content="Segui Windows" Tag="System"/><ComboBoxItem Content="Chiaro" Tag="Light"/><ComboBoxItem Content="Scuro" Tag="Dark"/></ComboBox>
        <TextBlock Text="Si applica subito. Con Segui Windows, Major segue il tema delle app di sistema." Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
        <CheckBox x:Name="CompactSidebarCheck" Content="Barra laterale compatta" Checked="PreferencesChanged" Unchecked="PreferencesChanged"/>
        <TextBlock Text="Avvio" Style="{StaticResource Section}" Margin="0,24,0,12"/>
        <TextBlock Text="Pagina da aprire" Margin="0,0,0,8"/><ComboBox x:Name="StartPageCombo" Width="300" HorizontalAlignment="Left" SelectionChanged="PreferencesChanged" AutomationProperties.Name="Pagina iniziale"><ComboBoxItem Content="Android USB / ADB" Tag="Usb"/><ComboBoxItem Content="Ricevi da iPhone/iPad" Tag="AirPlay"/><ComboBoxItem Content="Ricevi da Android Wi-Fi" Tag="Android"/></ComboBox>
        <TextBlock Text="Scegliendo una pagina di ricezione, il ricevitore si attiva all’apertura di Major." Style="{StaticResource MutedText}" Margin="0,8,0,16"/>
        <CheckBox x:Name="MaximizedCheck" Content="Apri la finestra massimizzata" Checked="PreferencesChanged" Unchecked="PreferencesChanged"/>
        <TextBlock Text="Screenshot e registrazioni" Style="{StaticResource Section}" Margin="0,24,0,12"/><TextBlock Text="Cartella usata dalle sessioni Android USB / ADB." Style="{StaticResource MutedText}"/><TextBlock x:Name="SettingsOutputPath" TextWrapping="Wrap" Margin="0,10,0,12"/>
        <WrapPanel><Button Content="Cambia cartella…" Click="ChooseFolderClick" Margin="0,0,8,8"/><Button Content="Apri cartella" Click="OpenFolderClick" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock Text="Diagnostica" Style="{StaticResource Section}" Margin="0,24,0,12"/><Button Content="Apri cartella diagnostica" Click="OpenDiagnosticsClick" HorizontalAlignment="Left"/><TextBlock Text="I registri aiutano a individuare problemi di connessione. Possono contenere nomi e indirizzi dei dispositivi." Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
        <TextBlock x:Name="PreferencesStatus" Text="Le modifiche vengono salvate automaticamente." Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel></ScrollViewer>
    </Border>
    <Grid x:Name="ReceiverPanels" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"/>
  </Grid>
</Window>

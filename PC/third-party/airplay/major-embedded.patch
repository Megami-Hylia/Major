@@ -24,8 +25,68 @@
 #include <gst/app/gstappsrc.h>
 #include "video_renderer.h"
 #include <gst/video/videooverlay.h>
+#ifdef _WIN32
+#include <windows.h>
+#endif
 
 static uintptr_t external_window_handle = 0;
+static gint major_first_frame = 0;
+
+#ifdef _WIN32
+static HWND major_canvas_parent = NULL;
+static HWND major_canvas_window = NULL;
+static HANDLE major_canvas_ready = NULL;
+
+static DWORD WINAPI major_canvas_thread(LPVOID unused) {
+    /* D3D11 subclasses its overlay HWND. That HWND must belong to this process,
+     * while WPF owns only its parent container. Keep its message pump alive. */
+    HANDLE ready = major_canvas_ready;
+    typedef HANDLE (WINAPI *get_context_fn)(HWND);
+    typedef HANDLE (WINAPI *set_context_fn)(HANDLE);
+    HMODULE user32 = GetModuleHandleW(L"user32.dll");
+    get_context_fn get_context = (get_context_fn) GetProcAddress(user32, "GetWindowDpiAwarenessContext");
+    set_context_fn set_context = (set_context_fn) GetProcAddress(user32, "SetThreadDpiAwarenessContext");
+    if (get_context && set_context) set_context(get_context(major_canvas_parent));
+    RECT rect = {0};
+    GetClientRect(major_canvas_parent, &rect);
+    major_canvas_window = CreateWindowExW(WS_EX_NOPARENTNOTIFY, L"STATIC", L"Major AirPlay video",
+        WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | WS_CLIPCHILDREN | SS_BLACKRECT,
+        0, 0, MAX(1, rect.right), MAX(1, rect.bottom), major_canvas_parent, NULL,
+        GetModuleHandleW(NULL), NULL);
+    SetEvent(ready);
+    if (!major_canvas_window) return 1;
+    g_printerr("Embedded D3D11 canvas created in receiver process (%ld x %ld)\n", rect.right, rect.bottom);
+    UINT_PTR timer = SetTimer(NULL, 0, 50, NULL);
+    MSG message;
+    while (GetMessageW(&message, NULL, 0, 0) > 0) {
+        if (message.message == WM_TIMER && message.wParam == timer) {
+            if (!IsWindow(major_canvas_parent)) break;
+            RECT next = {0};
+            if (GetClientRect(major_canvas_parent, &next) &&
+                (next.right != rect.right || next.bottom != rect.bottom)) {
+                rect = next;
+                MoveWindow(major_canvas_window, 0, 0, MAX(1, rect.right), MAX(1, rect.bottom), TRUE);
+            }
+        } else if (message.message == WM_KEYDOWN &&
+                   (message.wParam == VK_F11 || message.wParam == VK_ESCAPE)) {
+            PostMessageW(major_canvas_parent, message.message, message.wParam, message.lParam);
+            continue;
+        }
+        TranslateMessage(&message);
+        DispatchMessageW(&message);
+    }
+    if (timer) KillTimer(NULL, timer);
+    DestroyWindow(major_canvas_window);
+    return 0;
+}
+#endif
+
+static GstPadProbeReturn major_frame_probe(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+    if (external_window_handle && g_atomic_int_compare_and_exchange(&major_first_frame, 0, 1)) {
+        g_print("MAJOR_AIRPLAY\t%s\tstreaming\n", g_getenv("MAJOR_EVENT_NONCE"));
+    }
+    return GST_PAD_PROBE_OK;
+}
 

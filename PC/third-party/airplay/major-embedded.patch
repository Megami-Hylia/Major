  * If it has not already been called when the "prepare_window_handle" message is received, GStreamer
  * will create its own window (which is currently the case on all supported platforms) */
 void video_renderer_set_window_handle(uintptr_t handle) {
+#ifdef _WIN32
+    major_canvas_parent = (HWND) handle;
+    major_canvas_ready = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!major_canvas_ready) g_error("Cannot create embedded video readiness event");
+    HANDLE thread = CreateThread(NULL, 0, major_canvas_thread, NULL, 0, NULL);
+    if (!thread) g_error("Cannot start embedded video message pump");
+    DWORD result = WaitForSingleObject(major_canvas_ready, 5000);
+    CloseHandle(thread);
+    CloseHandle(major_canvas_ready);
+    if (result != WAIT_OBJECT_0 || !major_canvas_window) g_error("Cannot create embedded video child window");
+    external_window_handle = (uintptr_t) major_canvas_window;
+#else
     external_window_handle = handle;
+#endif
 }
 
